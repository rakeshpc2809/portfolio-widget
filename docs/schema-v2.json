{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortfolioWidgetStateV2",
  "description": "Provider-agnostic State v2 Contract for Portfolio Widget (iNiR / iRiS)",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "status",
    "freshness",
    "updated_at",
    "invested_portfolio",
    "total_networth",
    "buckets",
    "attention_items",
    "holdings",
    "sips",
    "sparkline_90d"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Schema contract version. Must be 2."
    },
    "provider": {
      "type": "string",
      "const": "indmoney",
      "description": "Upstream portfolio aggregator/connector identifier."
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "error", "auth_required"],
      "description": "Operational synchronization status."
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "aging", "stale", "partial", "auth_required"],
      "description": "Data staleness classification based on NAV windows and last successful sync."
    },
    "nav_as_of": {
      "type": ["string", "null"],
      "description": "Human-readable date of authoritative NAV / market close (e.g. '21 Oct 2026')."
    },
    "market_state": {
      "type": "string",
      "enum": ["IN_OPEN", "US_OPEN", "CLOSED", "CACHED"],
      "description": "Nominal market session derived from deterministic timestamp."
    },
    "failed_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of MCP tools/sources that failed during this run (e.g. ['bse_sip'])."
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch timestamp (seconds) when this state was normalized. Deterministically derived."
    },
    "invested_portfolio": {
      "type": "object",
      "description": "Invested assets (MF + IN_EQ + US_EQ + Gold). Used as denominator for 1D % change, drift, and sparkline.",
      "required": [
        "current_value_inr",
        "invested_value_inr",
        "total_return_inr",
        "total_return_pct",
        "one_day_change_inr",
        "one_day_change_pct"
      ],
      "properties": {
        "current_value_inr": { "type": "number", "minimum": 0 },
        "invested_value_inr": { "type": "number", "minimum": 0 },
        "total_return_inr": { "type": "number" },
        "total_return_pct": { "type": "number" },
        "one_day_change_inr": { "type": "number" },
        "one_day_change_pct": { "type": "number" }
      }
    },
    "total_networth": {
      "type": "object",
      "description": "Comprehensive net worth including static cash/bank balance and EPF.",
      "required": [
        "total_networth_inr",
        "bank_balance_inr",
        "epf_inr"
      ],
      "properties": {
        "total_networth_inr": { "type": "number", "minimum": 0 },
        "bank_balance_inr": { "type": "number", "minimum": 0 },
        "epf_inr": { "type": "number", "minimum": 0 }
      }
    },
    "buckets": {
      "type": "array",
      "description": "Target vs actual asset allocation buckets. Colors strictly reference IrisStyle.identity tokens.",
      "items": {
        "type": "object",
        "required": [
          "bucket_id",
          "label",
          "current_value_inr",
          "actual_pct",
          "target_pct",
          "drift_pct",
          "in_band",
          "palette_key"
        ],
        "properties": {
          "bucket_id": {
            "type": "string",
            "enum": ["core", "satellite", "gold_silver", "liquid", "legacy"]
          },
          "label": { "type": "string" },
          "current_value_inr": { "type": "number", "minimum": 0 },
          "actual_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "target_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "drift_pct": { "type": "number" },
          "in_band": { "type": "boolean" },
          "palette_key": {
            "type": "string",
            "enum": [
              "blue", "sky", "teal", "green", "yellow", "orange",
              "red", "pink", "indigo", "purple", "lavender", "gray"
            ],
            "description": "Verified IrisStyle.identity palette key. Zero hex colors in data plane."
          }
        }
      }
    },
    "attention_items": {
      "type": "array",
      "description": "Actionable notices (band breach, low cash buffer, partial sync, legacy asset). Empty array indicates calm status.",
      "items": {
        "type": "object",
        "required": ["type", "severity", "title", "message", "palette_key"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["band_breach", "sip_low_buffer", "stale_data", "partial_sync", "legacy_holding"]
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "alert"]
          },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "palette_key": {
            "type": "string",
            "enum": [
              "blue", "sky", "teal", "green", "yellow", "orange",
              "red", "pink", "indigo", "purple", "lavender", "gray"
            ]
          }
        }
      }
    },
    "holdings": {
      "type": "array",
      "description": "Consolidated holdings with bucket and class assignments.",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "class_id",
          "bucket_id",
          "current_value_inr",
          "invested_value_inr",
          "one_day_change_inr",
          "one_day_change_pct",
          "total_return_pct",
          "palette_key"
        ],
        "properties": {
          "symbol": { "type": "string" },
          "name": { "type": "string" },
          "isin": { "type": "string" },
          "class_id": {
            "type": "string",
            "enum": ["mf", "in_eq", "us_eq", "cash", "epf", "gold"]
          },
          "bucket_id": {
            "type": "string",
            "enum": ["core", "satellite", "gold_silver", "liquid", "legacy"]
          },
          "current_value_inr": { "type": "number", "minimum": 0 },
          "invested_value_inr": { "type": "number", "minimum": 0 },
          "one_day_change_inr": { "type": "number" },
          "one_day_change_pct": { "type": "number" },
          "total_return_pct": { "type": "number" },
          "palette_key": {
            "type": "string",
            "enum": [
              "blue", "sky", "teal", "green", "yellow", "orange",
              "red", "pink", "indigo", "purple", "lavender", "gray"
            ]
          }
        }
      }
    },
    "sips": {
      "type": "object",
      "description": "Normalized upcoming SIP schedule and 7-day liquidity coverage.",
      "required": [
        "monthly_total_inr",
        "monthly_total_usd",
        "active_count",
        "next_7d_sip_inr",
        "sip_coverage_ratio",
        "sip_coverage_ok",
        "upcoming"
      ],
      "properties": {
        "monthly_total_inr": { "type": "number", "minimum": 0 },
        "monthly_total_usd": { "type": "number", "minimum": 0 },
        "active_count": { "type": "integer", "minimum": 0 },
        "next_7d_sip_inr": { "type": "number", "minimum": 0 },
        "sip_coverage_ratio": { "type": "number", "minimum": 0 },
        "sip_coverage_ok": { "type": "boolean" },
        "upcoming": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "amount_inr", "next_date", "frequency", "class_id"],
            "properties": {
              "name": { "type": "string" },
              "amount_inr": { "type": "number", "minimum": 0 },
              "amount_usd": { "type": ["number", "null"] },
              "next_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "frequency": { "type": "string", "enum": ["monthly", "weekly", "quarterly"] },
              "class_id": { "type": "string", "enum": ["mf", "in_eq", "us_eq"] }
            }
          }
        }
      }
    },
    "sparkline_90d": {
      "type": "array",
      "description": "90-point daily historical series of invested_portfolio. Excludes static EPF & bank balance.",
      "items": {
        "type": "object",
        "required": ["date", "v"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "v": { "type": "number", "minimum": 0 }
        }
      }
    },
    "portfolio_os": {
      "type": "object",
      "description": "Optional merge slot for localhost Portfolio OS engine.",
      "properties": {
        "enabled": { "type": "boolean" },
        "xirr_pct": { "type": ["number", "null"] },
        "rebalance_action": { "type": ["string", "null"] }
      }
    }
  }
}
